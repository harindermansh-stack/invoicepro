# run `cp .env.example .env.local`
#
# Core invoice editing, live preview and browser PDF download do not require
# third-party service credentials.

# Optional Sentry observability. Leave disabled unless you configure Sentry.
SENTRY_ENABLED="false"
NEXT_PUBLIC_SENTRY_ENABLED="false"
NEXT_PUBLIC_SENTRY_DSN=""

# Optional Resend email integration. Requires a real Resend API key.
RESEND_API_KEY=""

# Optional Upstash Redis integration for API rate limiting and Telegram queueing.
# Requires real Upstash REST credentials when enabled by the related routes.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional bearer token for protected /api/generate-invoice automation.
AUTH_TOKEN=""

# Optional defaults for server-side invoice automation.
# The browser invoice editor has its own fictional defaults and does not need
# these values.

# Seller Info
SELLER_NAME="Adam Smith"
SELLER_ADDRESS="London, UK"
SELLER_VAT_NO="12345"
SELLER_EMAIL="seller@mail.com"
SELLER_ACCOUNT_NUMBER="12345"
SELLER_SWIFT_BIC="12345"

# Buyer Information
BUYER_NAME="Random Company"
BUYER_ADDRESS="Bristol, UK"
BUYER_VAT_NO="12345"
BUYER_EMAIL="buyer@mail.com"

INVOICE_NET_PRICE="10000"
INVOICE_EMAIL_RECIPIENT="seller@mail.com"
INVOICE_EMAIL_COMPANY_TO="buyer@mail.com"

# Optional Telegram notifications. Requires a real bot token and chat ID.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional Google Drive uploads. Requires real service-account credentials.
GOOGLE_DRIVE_CLIENT_EMAIL="example@mail.com"
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_PARENT_FOLDER_ID=""

# Optional GitHub token for authenticated star-count API requests.
# Leave blank to use unauthenticated public GitHub API access.
GITHUB_TOKEN=""
